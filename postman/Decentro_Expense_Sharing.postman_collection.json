          "name": "Settle Balance (Rahul pays Mohit 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_id\": 1,\n  \"payer_id\": 2,\n  \"payee_id\": 1,\n  \"amount\": 400,\n  \"notes\": \"Settling dinner expense\"\n}"
            },
            "url": {
