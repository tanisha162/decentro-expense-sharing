    {
      "name": "Part 3 — Expense Management",
      "item": [
        {
          "name": "Add Expense (Dinner = 1200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_id\": 1,\n  \"paid_by\": 1,\n  \"amount\": 1200,\n  \"description\": \"Dinner\",\n  \"category\": \"Food\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/expenses",
              "host": ["{{base_url}}"],
              "path": ["expenses"]
            }
          }
        },
        {
          "name": "Add Expense (Custom Unequal Splits)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_id\": 1,\n  \"paid_by\": 1,\n  \"amount\": 1000,\n  \"description\": \"Buffet Lunch\",\n  \"split_type\": \"EXACT\",\n  \"splits\": [\n    { \"user_id\": 1, \"amount\": 500 },\n    { \"user_id\": 2, \"amount\": 300 },\n    { \"user_id\": 3, \"amount\": 200 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/expenses",
              "host": ["{{base_url}}"],
              "path": ["expenses"]
            }
          }
        },
        {
          "name": "List Group Expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/groups/1/expenses",
              "host": ["{{base_url}}"],
              "path": ["groups", "1", "expenses"]
            }
          }
        }
