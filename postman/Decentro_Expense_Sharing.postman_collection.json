              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Goa Trip\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/groups",
              "host": ["{{base_url}}"],
              "path": ["groups"]
